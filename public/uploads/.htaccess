# Seguridad: Prevenir ejecución de scripts PHP
php_flag engine off

# Permitir solo ciertos tipos de archivos
<FilesMatch "\.(jpg|jpeg|png|gif|pdf|doc|docx|xls|xlsx|ppt|pptx|txt|zip|rar)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Denegar acceso a archivos potencialmente peligrosos
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|jsp|asp|aspx|shtml|sh)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Prevenir listado de directorios
Options -Indexes

